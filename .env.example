# Paper Desk Environment Variables Configuration
# Copy this file to .env and populate with real secrets

# Application Secret Key for session cookies & CSRF
SECRET_KEY=change-this-to-a-super-secret-hex-random-key-in-production

# Fernet key (32 url-safe base64-encoded bytes) for encrypting Kite tokens in DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=W3uG_1H9m3n8xK9Z8gV2eY7wQ6sL5pM4rT2bN1vC0xA=

# Authentication: Single user password for dashboard
ADMIN_USERNAME=trader
ADMIN_PASSWORD=ChangeMeNow123!

# Database connection string
# Local SQLite for immediate development: sqlite+aiosqlite:///./data/paperdesk.db
# Local Docker or Supabase Postgres: postgresql+psycopg://postgres:postgres@localhost:5432/paperdesk
DATABASE_URL=sqlite+aiosqlite:///./data/paperdesk.db

# Zerodha Kite Connect Credentials
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_REDIRECT_URL=http://localhost:8000/login/kite/callback

# Market Data Feed Mode: "sim" | "replay" | "kite"
FEED_MODE=sim

# Execution Configuration
PESSIMISTIC_FILLS=true

# Logging
LOG_LEVEL=INFO

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
